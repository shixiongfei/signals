{
  "name": "@shidev/signals",
  "version": "1.1.2",
  "description": "A very simple alien-signals wrapper, designed for simpler use only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.4.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node ./src/index.test.ts",
    "coverage": "node --test --experimental-test-coverage ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixiongfei/signals.git"
  },
  "files": [
    "dist",
    "src",
    "!dist/*.test.*",
    "!src/*.test.*"
  ],
  "keywords": [
    "signal",
    "signals",
    "alien-signals",
    "observe",
    "observer",
    "reactive",
    "reactivity"
  ],
  "author": "shixiongfei",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/shixiongfei/signals/issues"
  },
  "homepage": "https://github.com/shixiongfei/signals#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "alien-signals": "^3.2.1"
  }
}
